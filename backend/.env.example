# --- App ---
NODE_ENV=development
PORT=3000

# --- Banco ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lojafacil?schema=public"

# --- Redis / filas ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="troque-em-producao"
JWT_REFRESH_SECRET="troque-em-producao"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Criptografia de tokens de marketplace (AES-256-GCM, 32 bytes em hex/base64) ---
TOKEN_ENCRYPTION_KEY="chave-de-32-bytes-em-base64-aqui"

# --- Mercado Livre (MVP) ---
MELI_CLIENT_ID=""
MELI_CLIENT_SECRET=""
MELI_REDIRECT_URI="http://localhost:3000/stores/oauth/meli/callback"

# --- Shopee (MVP) ---
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_REDIRECT_URI="http://localhost:3000/stores/oauth/shopee/callback"

# --- TikTok Shop (Fase 2 — requer aprovação no Partner Center) ---
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""

# --- Provedores (Fase 2) ---
FOCUS_NFE_TOKEN=""
MELHOR_ENVIO_TOKEN=""

# --- Feature flags de canais ---
FEATURE_TIKTOK=false
FEATURE_SHEIN=false
